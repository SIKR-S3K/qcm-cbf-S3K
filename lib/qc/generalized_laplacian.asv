function A = generalized_laplacian(v,f,mu)

% Compute the generalized Laplacian.
% 
% If you use this code in your own work, please cite the following paper:
% [1] P. T. Choi and L. M. Lui, 
%     "Fast Disk Conformal Parameterization of Simply-Connected Open Surfaces."
%     Journal of Scientific Computing, 65(3), pp. 1065-1090, 2015.
%
% Copyright (c) 2014-2018, Gary Pui-Tung Choi
% https://scholar.harvard.edu/choi

% Input:
% v: nv x 2 vertex coordinates of a simply-connected open triangle mesh
% f: nf x 3 triangulations of a simply-connected open triangle mesh
% mu = zeros(length(f),1); 
% mu_bound = 0.95;
% while max(abs(mu)) >= mu_bound
%     mu(abs(mu)>=mu_bound) = mu_bound*mu(abs(mu)>=mu_bound)./abs(mu(abs(mu)>=mu_bound));
% mu = beltrami_coefficient(v, f, map);

af = (1-2*real(mu)+abs(mu).^2)./(1.0-abs(mu).^2);
bf = -2*imag(mu)./(1.0-abs(mu).^2);
gf = (1+2*real(mu)+abs(mu).^2)./(1.0-abs(mu).^2);
% time = O(length(f)), the operations are done on each component of mu

f0 = f(:,1); f1 = f(:,2); f2 = f(:,3);

uxv0 = v(f1,2) - v(f2,2);
uyv0 = v(f2,1) - v(f1,1);
uxv1 = v(f2,2) - v(f0,2);
uyv1 = v(f0,1) - v(f2,1); 
uxv2 = v(f0,2) - v(f1,2);
uyv2 = v(f1,1) - v(f0,1);
% time = O(length(f)), by definition of Triangulation, 
% length of f(:,i) = length(f)

l = [sqrt(sum(uxv0.^2 + uyv0.^2,2)), sqrt(sum(uxv1.^2 + uyv1.^2,2)), sqrt(sum(uxv2.^2 + uyv2.^2,2))];
% time = O(length(f))
% why do we need to sum(uxv0.^2 + uyv0.^2,2), that is summing each row?
% f is nf x 3 triangulations of a simply-connected open triangle mesh means
% f0, f1, f2 must be column vectors, then sum(,2) is not necessary?
s = sum(l,2)*0.5;
% length of s = length(f)

area = sqrt(s.*(s-l(:,1)).*(s-l(:,2)).*(s-l(:,3)));
% time = O(length(f))
% Heron's formula is used to calculate area of triangle

v00 = (af.*uxv0.*uxv0 + 2*bf.*uxv0.*uyv0 + gf.*uyv0.*uyv0)./area;
v11 = (af.*uxv1.*uxv1 + 2*bf.*uxv1.*uyv1 + gf.*uyv1.*uyv1)./area;
v22 = (af.*uxv2.*uxv2 + 2*bf.*uxv2.*uyv2 + gf.*uyv2.*uyv2)./area;
v01 = (af.*uxv1.*uxv0 + bf.*uxv1.*uyv0 + bf.*uxv0.*uyv1 + gf.*uyv1.*uyv0)./area;
v12 = (af.*uxv2.*uxv1 + bf.*uxv2.*uyv1 + bf.*uxv1.*uyv2 + gf.*uyv2.*uyv1)./area;
v20 = (af.*uxv0.*uxv2 + bf.*uxv0.*uyv2 + bf.*uxv2.*uyv0 + gf.*uyv0.*uyv2)./area;
% time = O(length(f))

I = [f0;f1;f2;f0;f1;f1;f2;f2;f0];
J = [f0;f1;f2;f1;f0;f2;f1;f0;f2];
V = [v00;v11;v22;v01;v01;v12;v12;v20;v20]/2;
A = sparse(I,J,-V);
% time = O(length(f))
% max(f(:))*max(f(:)) matrix with 9*length(f) nonzero entries